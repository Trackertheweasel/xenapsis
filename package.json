{
  "name": "persec",
  "type": "module",
  "version": "2.0.1",
  "packageManager": "pnpm@10.34.9",
  "scripts": {
    "dev": "npx astro dev --host 0.0.0.0",
    "start": "node --trace-warnings --enable-source-maps --import tsx index.ts",
    "build": "astro telemetry disable && npx astro check && npx astro build",
    "test": "node --import tsx --test tests/*.test.ts",
    "invite": "tsx scripts/invite.ts",
    "format": "npx prettier . --write",
    "revert": "git reset HEAD --hard && git clean -fd",
    "precommit": "npx astro check && npm run format"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.12",
    "@astrojs/node": "^9.5.2",
    "@fastify/compress": "^9.2.2",
    "@fastify/helmet": "^13.0.2",
    "@fastify/middie": "^9.3.6",
    "@fastify/static": "^9.0.0",
    "@fontsource/outfit": "^5.3.0",
    "@fontsource/prompt": "^5.3.0",
    "@mercuryworkshop/bare-mux": "^2.1.9",
    "@mercuryworkshop/libcurl-transport": "^1.5.1",
    "@mercuryworkshop/scramjet": "^1.1.0",
    "@mercuryworkshop/wisp-js": "^0.4.1",
    "@playform/compress": "^0.2.1",
    "@tailwindcss/vite": "^4.1.18",
    "@titaniumnetwork-dev/ultraviolet": "^3.2.10",
    "astro": "^5.18.0",
    "chalk": "^5.6.2",
    "esbuild": "^0.28.2",
    "fastify": "^5.12.7",
    "localforage": "^1.10.0",
    "lucide": "^1.61.0",
    "node-fetch": "^3.3.2",
    "prettier-plugin-astro": "^1.1.2",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vite": "^8.3.5",
    "vite-plugin-static-copy": "^3.2.0"
  },
  "engines": {
    "node": ">=20.x"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "prettier": "^3.7.4"
  },
  "pnpm": {
    "ignoredBuiltDependencies": [
      "@mercuryworkshop/scramjet",
      "bufferutil",
      "esbuild",
      "sharp"
    ]
  }
}
