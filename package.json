{
  "name": "persec",
  "type": "module",
  "version": "2.6.0",
  "packageManager": "pnpm@10.34.9",
  "scripts": {
    "dev": "npx astro dev --host 0.0.0.0",
    "start": "node --trace-warnings --enable-source-maps --import tsx index.ts",
    "build": "astro telemetry disable && npx astro check && npx astro build && tsx scripts/disguise.ts && tsx scripts/precompress.ts && pnpm build:server",
    "build:server": "esbuild index.ts scripts/invite.ts --bundle --platform=node --format=esm --packages=external --target=node22 --sourcemap --outdir=dist --entry-names=[name] --out-extension:.js=.mjs --log-level=warning",
    "test": "node --import tsx --test tests/*.test.ts",
    "invite": "tsx scripts/invite.ts",
    "format": "npx prettier . --write",
    "revert": "git reset HEAD --hard && git clean -fd",
    "precommit": "npx astro check && npm run format"
  },
  "dependencies": {
    "@astrojs/node": "^11.1.9",
    "@fastify/compress": "^9.2.2",
    "@fastify/helmet": "^13.2.0",
    "@fastify/middie": "^9.3.6",
    "@fastify/static": "^10.1.8",
    "@mercuryworkshop/wisp-js": "^0.4.1",
    "astro": "^7.4.2",
    "chalk": "^5.6.2",
    "fastify": "^5.12.7"
  },
  "engines": {
    "node": ">=22.23.4"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@fontsource/outfit": "^5.3.0",
    "@fontsource/prompt": "^5.3.0",
    "@mercuryworkshop/bare-mux": "^2.1.9",
    "@mercuryworkshop/libcurl-transport": "^1.5.1",
    "@mercuryworkshop/scramjet": "^1.1.0",
    "@playform/compress": "^0.2.5",
    "@tailwindcss/vite": "^4.1.18",
    "@titaniumnetwork-dev/ultraviolet": "^3.2.10",
    "@types/node": "^26.6.5",
    "esbuild": "^0.28.2",
    "happy-dom": "^21.0.4",
    "localforage": "^1.10.0",
    "lucide": "^1.61.0",
    "prettier": "^3.7.4",
    "prettier-plugin-astro": "^1.1.2",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^8.3.5",
    "vite-plugin-static-copy": "^4.1.1"
  },
  "pnpm": {
    "ignoredBuiltDependencies": [
      "@mercuryworkshop/scramjet",
      "bufferutil",
      "esbuild",
      "sharp"
    ],
    "overrides": {
      "picomatch@<2.3.2": "^2.3.2",
      "picomatch@>=4.0.0 <4.0.4": "^4.0.4",
      "sharp@<0.35.4": "^0.35.4",
      "deepmerge-ts@<8.0.0": "^8.0.2",
      "svgo@>=4.0.0 <4.1.0": "^4.1.0"
    },
    "patchedDependencies": {
      "@mercuryworkshop/wisp-js@0.4.1": "patches/@mercuryworkshop__wisp-js@0.4.1.patch"
    }
  }
}
