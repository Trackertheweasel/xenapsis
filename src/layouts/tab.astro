---
import ImportLucide from './lucide.astro';
import '@/main.css';

// Phones show Forward in the menu instead, like mobile browsers, to leave room for the address bar.
const navButtons = [
  { id: 'back', icon: 'arrow-left', label: 'Back' },
  { id: 'forward', icon: 'arrow-right', label: 'Forward', class: 'max-sm:hidden' },
  {
    id: 'refresh',
    icon: 'refresh-cw',
    label: 'Reload',
    class: 'group',
    iconClass: 'transition-transform duration-500',
  },
  { id: 'home', icon: 'house', label: 'Home' },
];

// src/utils/menu.ts finds each item by its id.
const menuSections = [
  [
    { id: 'newTab', icon: 'plus', label: 'New Tab' },
    { id: 'reopen', icon: 'rotate-ccw', label: 'Reopen Closed Tab' },
    { id: 'fullscreen', icon: 'maximize-2', label: 'Full Screen' },
    { id: 'reload', icon: 'refresh-cw', label: 'Reload' },
    { id: 'other-engine', icon: 'shuffle', label: 'Try the Other Engine' },
  ],
  [
    { id: 'bookmarks', icon: 'bookmark', label: 'Bookmarks' },
    { id: 'inspectElement', icon: 'code', label: 'Inspect Element' },
    { id: 'darkmode', icon: 'moon', label: 'Dark Mode' },
    { id: 'cloak', icon: 'glasses', label: 'AB Cloak' },
  ],
  [
    { id: 'help', icon: 'circle-help', label: 'Getting Started' },
    { id: 'panic', icon: 'log-out', label: 'Panic' },
    { id: 'settings', icon: 'settings', label: 'Settings' },
  ],
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <script src="@scripts/tb.ts"></script>
    <script src="@scripts/menu.ts"></script>
    <script src="@scripts/suggestions.ts"></script>
  </head>

  <body class="bg-gray-900 p-3 font-sans text-sm text-white">
    <div class="w-full">
      <div
        id="tab-wrapper"
        class="relative isolate flex h-12 items-end overflow-hidden rounded-t-xl bg-[#1c1a2b] px-1.5"
      >
        <div class="flex w-full items-center gap-1.5">
          <div
            id="tcontainer"
            role="tablist"
            aria-label="Tabs"
            class="flex max-w-full min-w-0 flex-nowrap gap-1.5 overflow-x-auto [scrollbar-width:none]"
          ></div>
          <button
            id="add"
            aria-label="New tab"
            title="New tab"
            class="relative -top-1/2 flex h-7 w-7 shrink-0 items-center justify-center rounded-md text-gray-400 transition hover:bg-gray-700 hover:text-white max-sm:w-9"
          >
            <i data-lucide="plus" class="h-3.5 w-3.5"></i>
          </button>
        </div>
      </div>

      <div class="flex h-12 items-center gap-1.5 border-t border-[#3a3758] bg-[#1c1a2b] px-2 sm:h-10 sm:gap-3 sm:px-3">
        <div class="flex shrink-0 items-center gap-0.5 sm:gap-1.5">
          {navButtons.map(({ id, icon, label, class: btnClass, iconClass }) => (
            <button
              id={id}
              aria-label={label}
              title={label}
              class:list={[
                'flex h-9 w-9 items-center justify-center rounded-md text-gray-400 transition hover:bg-gray-700 hover:text-white sm:h-7 sm:w-7',
                btnClass,
              ]}
            >
              <i
                data-lucide={icon}
                class:list={['h-3.5 w-3.5', iconClass, id === 'refresh' ? 'group-hover:animate-spin' : '']}
              />
            </button>
          ))}
        </div>

        <div class="relative flex min-w-0 grow flex-col">
          <div class="relative w-full">
            <div class="absolute top-1/2 left-2.5 z-20 flex -translate-y-1/2 items-center gap-2">
              <i data-lucide="lock" class="h-3.5 w-3.5 text-green-500"></i>
            </div>

            <input
              id="urlbar"
              type="text"
              role="combobox"
              aria-autocomplete="list"
              aria-expanded="false"
              aria-controls="suggestions"
              autocomplete="off"
              autocapitalize="off"
              autocorrect="off"
              spellcheck="false"
              enterkeyhint="go"
              aria-label="Search or enter address"
              class="h-9 w-full rounded-full border border-[#3a3758] bg-[#23213a] pr-10 pl-9 text-base text-gray-200 transition-colors placeholder:text-gray-500 hover:text-white focus:border-[#8b87ff] focus:outline-none sm:h-8 sm:text-[13px]"
              placeholder="Search or enter address"
            />

            <button
              id="fav"
              aria-label="Bookmark this page"
              aria-pressed="false"
              title="Bookmark this page"
              class="absolute top-1/2 right-1 flex h-7 w-7 -translate-y-1/2 items-center justify-center rounded-full text-gray-400 transition hover:bg-gray-700 hover:text-white sm:h-6 sm:w-6 sm:rounded-md"
            >
              <i data-lucide="bookmark" class="h-4 w-4"></i>
            </button>

            <div
              id="loading-bar"
              class="pointer-events-none fixed inset-x-0 z-50 hidden h-0.5 w-screen rounded-full bg-[#5c59a5] opacity-0 transition-all duration-200"
            ></div>
          </div>
        </div>

        <button
          id="menubtn"
          aria-label="Menu"
          aria-haspopup="menu"
          aria-controls="menu"
          aria-expanded="false"
          class="flex h-9 w-9 shrink-0 items-center justify-center rounded-md text-gray-400 transition hover:bg-gray-700 hover:text-white sm:h-7 sm:w-7"
        >
          <i data-lucide="menu" class="h-4 w-4"></i>
        </button>
      </div>

      <div class="relative">
        <div
          id="menu"
          role="menu"
          class="absolute top-full right-2 z-1000 mt-2 hidden max-h-[calc(100dvh-7rem)] w-56 overflow-hidden overflow-y-auto rounded-xl border border-[#3a3758] bg-[#1f1f30] shadow-2xl backdrop-blur-md sm:right-0"
        >
          <button
            id="menu-forward"
            role="menuitem"
            tabindex="-1"
            class="flex w-full items-center gap-3 px-3.5 py-3 text-gray-200 transition hover:bg-[#2a293f] hover:text-white sm:hidden"
          >
            <i data-lucide="arrow-right" class="h-4.5 w-4.5 shrink-0"></i>
            <span class="text-sm whitespace-nowrap">Forward</span>
          </button>
          {menuSections.map((section, i) => (
            <div
              class:list={[
                'flex flex-col',
                i !== 0 ? 'border-t border-[#3a3758]' : 'max-sm:border-t max-sm:border-[#3a3758]',
              ]}
            >
              {section.map(({ id, icon, label }) => (
                <button
                  id={`menu-${id}`}
                  role="menuitem"
                  tabindex="-1"
                  class="menu-item flex w-full items-center gap-3 px-3.5 py-3 text-gray-200 transition hover:bg-[#2a293f] hover:text-white sm:py-2.25"
                >
                  <i data-lucide={icon} class="h-4.5 w-4.5 shrink-0" />
                  <span class="text-sm whitespace-nowrap sm:text-[13px]">{label}</span>
                </button>
              ))}
            </div>
          ))}
        </div>
      </div>

      <!-- Messages from the browser's own controls (src/utils/navigation.ts notify). -->
      <div
        id="persec-status"
        role="status"
        class="pointer-events-none fixed bottom-4 left-1/2 z-1000 opacity-0 transition-opacity max-w-[calc(100vw-2rem)] -translate-x-1/2 rounded-lg border border-[#3a3758] bg-[#1f1f30] px-4 py-2.5 text-sm text-gray-100 shadow-2xl"
      ></div>

      <div
        id="fcontainer"
        class="absolute inset-x-0 top-24 bottom-0 w-full overflow-hidden rounded-b-lg sm:top-[5.6rem]"
      ></div>

      <ImportLucide />
    </div>
  </body>
</html>
