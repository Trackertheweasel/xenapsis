---
import '@/main.css';
import ImportLucide from './lucide.astro';
---

<!-- Filled from the saved shortcuts by src/utils/shortcuts.ts. -->
<div class="relative mt-8 flex w-full max-w-sm flex-col items-center sm:mt-10 sm:max-w-4xl sm:px-2">
  <ul
    id="shortcuts"
    aria-label="Shortcuts"
    class="grid w-full grid-cols-3 gap-3 sm:flex sm:flex-row sm:flex-wrap sm:items-center sm:justify-center sm:gap-7"
  ></ul>
  <p id="shortcuts-empty" hidden class="text-sm text-white/60">
    No shortcuts yet.
  </p>
  <a
    href="/bm"
    class="mt-4 inline-flex min-h-11 items-center gap-2 rounded-full px-4 text-sm text-white/60 hover:text-white/90"
  >
    <i data-lucide="pencil" class="h-4 w-4"></i>Edit shortcuts and bookmarks
  </a>
</div>
<script src="@scripts/shortcuts.ts"></script>
<ImportLucide />
