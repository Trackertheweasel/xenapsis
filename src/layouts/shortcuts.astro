---
import '@/main.css';
import ImportLucide from './lucide.astro';
---

<!-- Filled from the saved bookmarks by src/utils/shortcuts.ts: the first 12 are the tiles. -->
<section aria-label="Shortcuts" class="relative z-10 mt-8 flex w-full max-w-3xl flex-col items-center sm:mt-10 sm:px-2">
  <ul id="shortcuts" class="grid w-full grid-cols-3 gap-3 sm:grid-cols-4 sm:gap-4 lg:grid-cols-6"></ul>

  <div
    id="shortcuts-empty"
    hidden
    class="border-border-default/40 bg-background-overlay/50 w-full max-w-md rounded-2xl border border-dashed px-6 py-8 text-center"
  >
    <p class="font-medium text-white/90">Your start page has no shortcuts</p>
    <p class="mt-1 text-sm text-white/60">Add the sites you open most, or start with a few suggestions.</p>
    <button
      type="button"
      id="shortcuts-starters"
      class="mt-4 min-h-11 rounded-lg border border-white/10 bg-white/5 px-4 text-sm hover:bg-white/10"
    >
      Add suggested sites
    </button>
  </div>

  <div class="mt-5 flex flex-wrap items-center justify-center gap-2">
    <button
      type="button"
      id="shortcut-add"
      class="border-accent/40 bg-accent/15 hover:bg-accent/25 inline-flex min-h-11 items-center gap-2 rounded-full border px-4 text-sm font-medium text-white"
    >
      <i data-lucide="plus" class="h-4 w-4"></i>Add shortcut
    </button>
    <button
      type="button"
      data-customize-open
      class="inline-flex min-h-11 items-center gap-2 rounded-full border border-white/10 bg-white/5 px-4 text-sm text-white/80 hover:bg-white/10 hover:text-white"
    >
      <i data-lucide="settings" class="h-4 w-4"></i>Customize
    </button>
    <a
      href="/bm"
      id="shortcuts-more"
      class="inline-flex min-h-11 items-center gap-2 rounded-full px-3 text-sm text-white/60 hover:text-white/90"
    >
      All bookmarks
    </a>
  </div>
  <p id="shortcuts-status" role="status" class="mt-2 min-h-5 text-center text-sm text-white/60"></p>
</section>

<dialog
  id="shortcut-dialog"
  aria-labelledby="shortcut-title"
  class="border-border-default/60 bg-background-overlay m-auto max-h-[calc(100dvh-2rem)] w-[min(26rem,calc(100%-2rem))] overflow-y-auto rounded-2xl border text-white shadow-2xl backdrop:bg-black/60"
>
  <form id="shortcut-form" class="space-y-4 p-5 sm:p-6" novalidate>
    <h2 id="shortcut-title" class="text-lg font-semibold text-white">
      Add shortcut
    </h2>
    <div class="space-y-1">
      <label for="shortcut-name" class="block text-sm font-medium text-white/90">
        Name
      </label>
      <input
        id="shortcut-name"
        name="name"
        maxlength="60"
        autocomplete="off"
        placeholder="Optional"
        class="bg-background/80 focus:border-accent/70 focus-visible:ring-accent/40 w-full rounded-lg border border-white/10 px-3 py-2.5 text-sm text-white focus:outline-none focus-visible:ring-2"
      />
    </div>
    <div class="space-y-1">
      <label for="shortcut-url" class="block text-sm font-medium text-white/90">
        Web address
      </label>
      <input
        id="shortcut-url"
        name="url"
        required
        maxlength="2048"
        inputmode="url"
        autocapitalize="off"
        autocomplete="off"
        spellcheck="false"
        placeholder="example.com"
        aria-describedby="shortcut-error"
        class="bg-background/80 focus:border-accent/70 focus-visible:ring-accent/40 aria-invalid:border-red-400/70 w-full rounded-lg border border-white/10 px-3 py-2.5 text-sm text-white focus:outline-none focus-visible:ring-2"
      />
    </div>
    <p id="shortcut-error" class="min-h-5 text-sm text-red-300"></p>

    <div data-edit-only class="flex flex-wrap gap-2">
      <button
        type="button"
        data-move="-1"
        class="inline-flex min-h-11 items-center gap-1.5 rounded-lg border border-white/10 bg-white/5 px-3 text-sm hover:bg-white/10 disabled:opacity-40"
      >
        <i data-lucide="arrow-left" class="h-4 w-4"></i>Move earlier
      </button>
      <button
        type="button"
        data-move="1"
        class="inline-flex min-h-11 items-center gap-1.5 rounded-lg border border-white/10 bg-white/5 px-3 text-sm hover:bg-white/10 disabled:opacity-40"
      >
        Move later<i data-lucide="arrow-right" class="h-4 w-4"></i>
      </button>
      <button
        type="button"
        data-remove
        class="ml-auto inline-flex min-h-11 items-center gap-1.5 rounded-lg border border-red-500/30 bg-red-500/10 px-3 text-sm text-red-300 hover:bg-red-500/20"
      >
        <i data-lucide="trash-2" class="h-4 w-4"></i>Remove
      </button>
    </div>

    <div class="flex justify-end gap-2 border-t border-white/10 pt-4">
      <button
        type="button"
        data-cancel
        class="min-h-11 rounded-lg border border-white/10 bg-white/5 px-4 text-sm hover:bg-white/10"
      >
        Cancel
      </button>
      <button
        type="submit"
        class="border-accent/40 bg-accent/20 hover:bg-accent/30 min-h-11 rounded-lg border px-5 text-sm font-medium"
      >
        Save
      </button>
    </div>
  </form>
</dialog>

<script src="@scripts/shortcuts.ts"></script>
<ImportLucide />
