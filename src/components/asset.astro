---
import '@/main.css';
import ImportLucide from '../layouts/lucide.astro';

interface Game {
  name: string;
  desc: string;
  url: string;
  // Picture filling the card. Optional: cards without one show their logo or first letter instead.
  icon: string;
  // Small square logo bundled with Persec, shown on the tile.
  logo?: string;
  // The section it is also listed under, such as "Movies & TV". Everything shows under All.
  section?: string;
}

// A steady colour per name, so letter tiles are easy to tell apart.
const hue = (name: string) => [...name].reduce((h, c) => (h * 31 + c.charCodeAt(0)) % 360, 7);

const { list = [] }: { list?: Game[] } = Astro.props;
const { type = '' }: { type?: string } = Astro.props;
const sorted = [...list].sort((a, b) => a.name.localeCompare(b.name));
const sections = [...new Set(list.map(g => g.section).filter(Boolean))].sort() as string[];
---

<html lang="en">
  <body class="bg-background font-linux text-text-header min-h-screen">
    <div class="mx-auto max-w-7xl p-4 sm:p-6">
      <div class="mb-6">
        <div class="mb-4 flex items-center justify-between">
          <h1 class="text-2xl font-bold">
            {type === 'games' ? 'Persec Games' : type === 'app' ? 'Persec Apps' : 'Assets'}
          </h1>
          <div class="flex items-center gap-2">
            <div class="bg-background-overlay flex gap-1 rounded-lg p-1">
              <button
                data-view="grid"
                aria-label="Large grid"
                class="bg-background text-text-header flex h-9 w-9 items-center justify-center rounded transition-colors"
              >
                <i data-lucide="grid-3x3" class="h-4 w-4"></i>
              </button>
              <button
                data-view="compact"
                aria-label="Compact grid"
                class="text-text-secondary flex h-9 w-9 items-center justify-center rounded transition-colors"
              >
                <i data-lucide="layout-grid" class="h-4 w-4"></i>
              </button>
              <button
                data-view="list"
                aria-label="List"
                class="text-text-secondary flex h-9 w-9 items-center justify-center rounded transition-colors"
              >
                <i data-lucide="list" class="h-4 w-4"></i>
              </button>
            </div>
          </div>
        </div>

        <div class="mb-3 flex flex-wrap items-center gap-2">
          <div class="relative max-w-md min-w-0 flex-1 basis-full sm:min-w-60 sm:basis-auto">
            <i data-lucide="search" class="text-text-secondary absolute top-1/2 left-3 h-4 w-4 -translate-y-1/2"></i>
            <input
              type="text"
              data-input
              aria-label={`Search the ${type === 'games' ? 'Games' : type === 'app' ? 'Apps' : 'Assets'}`}
              placeholder={`Search the ${type === 'games' ? 'Games' : type === 'app' ? 'Apps' : 'Assets'}`}
              class="bg-background-overlay text-text-header placeholder-text-secondary/60 focus:ring-text-secondary/30 h-10 w-full rounded-lg pr-3 pl-10 text-sm focus:ring-1 focus:outline-none"
            />
          </div>
          <button
            data-random
            class="bg-background-overlay text-text-secondary hover:bg-background hover:text-text-header flex h-10 items-center gap-2 rounded-lg px-3 text-sm transition-colors"
          >
            <i data-lucide="shuffle" class="h-4 w-4"></i>
            Random
          </button>
          <button
            data-sort
            class="bg-background-overlay text-text-secondary hover:bg-background hover:text-text-header flex h-10 items-center gap-2 rounded-lg px-3 text-sm transition-colors"
          >
            <i data-lucide="arrow-up-down" class="h-4 w-4"></i>
            <span>A-Z</span>
          </button>
        </div>

        {sections.length > 0 && (
          <div data-sections role="group" aria-label="Sections" class="mb-3 flex flex-wrap gap-2">
            {['', ...sections].map(section => (
              <button
                type="button"
                data-section={section}
                aria-pressed={section === '' ? 'true' : 'false'}
                class="bg-background-overlay text-text-secondary hover:text-text-header aria-pressed:bg-text-header aria-pressed:text-background h-9 rounded-full px-4 text-sm transition-colors"
              >
                {section || 'All'}
              </button>
            ))}
          </div>
        )}

        <div class="text-text-secondary text-sm">
          Showing{' '}
          <span data-visible class="text-text-header">
            {sorted.length}
          </span>{' '}
          of <span data-total>{sorted.length}</span>
        </div>
      </div>

      <div data-type={type} data-container class="grid grid-cols-2 gap-3 sm:gap-4 md:grid-cols-3 lg:grid-cols-4">
        <button
          type="button"
          data-add-custom
          class="bg-background-overlay text-text-secondary hover:text-text-header hover:border-text-secondary/60 flex h-44 flex-col items-center justify-center gap-2 rounded-lg border-2 border-dashed border-white/15 transition-colors"
        >
          <i data-lucide="plus" class="h-8 w-8"></i>
          <span class="font-semibold">Add your own</span>
          <span class="px-4 text-center text-xs">Any site, saved in this browser only</span>
        </button>
        {sorted.map(g => (
          <div
            data-href={g.url}
            data-name={g.name}
            data-section={g.section}
            data-bg={g.icon || undefined}
            role="link"
            tabindex="0"
            aria-label={`Open ${g.name}`}
            class="card card-loading group bg-background-overlay relative flex h-44 cursor-pointer flex-col justify-end overflow-hidden rounded-lg transition-transform hover:scale-[1.02] focus-visible:ring-2 focus-visible:ring-[#6366f1] focus-visible:outline-none"
            style="animation: fadeIn 0.3s ease-out"
          >
            <div
              class="card-tile absolute inset-0 flex items-start justify-center pt-6"
              style={`background: linear-gradient(135deg, hsl(${hue(g.name)} 45% 30%), hsl(${(hue(g.name) + 40) % 360} 40% 18%))`}
              aria-hidden="true"
            >
              {g.logo ? (
                <img src={g.logo} alt="" class="h-14 w-14 rounded-xl bg-white/90 object-contain p-2" />
              ) : (
                <span class="text-5xl leading-none font-black text-white/80">{g.name.charAt(0).toUpperCase()}</span>
              )}
            </div>
            <div class="card-bg absolute inset-0 bg-cover bg-center opacity-70 transition-opacity group-hover:opacity-80" />
            <div class="absolute inset-0 bg-linear-to-t from-black/80 via-black/40 to-transparent" />
            <div class="relative z-10 p-4">
              <h2 class="mb-1 font-semibold text-white drop-shadow-lg">{g.name}</h2>
              <p class="line-clamp-2 text-xs text-gray-300 drop-shadow-md">{g.desc}</p>
            </div>
          </div>
        ))}
      </div>

      <div data-empty class="hidden flex-col items-center justify-center py-16 text-center">
        <div class="bg-background-overlay rounded-lg p-8">
          <i data-lucide="inbox" class="text-text-secondary/50 mx-auto mb-3 h-12 w-12"></i>
          <h3 class="text-text-header mb-1 text-lg font-semibold">No assets found</h3>
          <p class="text-text-secondary text-sm">Try a different search</p>
        </div>
      </div>
    </div>

    <dialog
      data-custom-dialog
      aria-labelledby="custom-title"
      class="bg-background-overlay text-text-header m-auto w-[min(26rem,calc(100%-2rem))] rounded-xl border border-white/10 p-5 backdrop:bg-black/60"
    >
      <form data-custom-form method="dialog" class="space-y-3">
        <h2 id="custom-title" class="text-lg font-semibold">
          Add your own {type === 'games' ? 'game' : 'app'}
        </h2>
        <label class="block text-sm">
          <span class="mb-1 block">Name</span>
          <input
            name="name"
            maxlength="60"
            class="bg-background text-text-header h-10 w-full rounded-lg px-3 text-sm focus:outline-none"
          />
        </label>
        <label class="block text-sm">
          <span class="mb-1 block">Address</span>
          <input
            name="url"
            required
            inputmode="url"
            placeholder="example.com"
            class="bg-background text-text-header h-10 w-full rounded-lg px-3 text-sm focus:outline-none"
          />
        </label>
        <p data-custom-error role="alert" class="min-h-4 text-xs text-red-300"></p>
        <div class="flex justify-end gap-2">
          <button
            type="button"
            data-custom-cancel
            class="text-text-secondary hover:text-text-header h-10 rounded-lg px-4 text-sm"
          >
            Cancel
          </button>
          <button type="submit" class="bg-accent h-10 rounded-lg px-4 text-sm font-semibold text-black">
            Add
          </button>
        </div>
      </form>
    </dialog>

    <ImportLucide />
    <script src="../utils/assets"></script>
  </body>
</html>
