---
// Static page: built once at deploy time instead of rendered on every request.
export const prerender = true;
import '@/main.css';
import AppLayout from '../components/asset.astro';
import ProxyRuntime from '../components/ProxyRuntime.astro';
import apList from '@assets/json/lists.json';

const aList = apList.aps;
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Persec Apps</title>
  </head>
  <body>
    <ProxyRuntime />
    <AppLayout list={aList} type="app" />
  </body>
</html>
