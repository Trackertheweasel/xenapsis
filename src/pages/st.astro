---
// Static page: built once at deploy time instead of rendered on every request.
export const prerender = true;
import '@/main.css';
import ImportLucide from '../layouts/lucide.astro';
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Settings</title>
    <style>
      .toggle,
      .switch {
        width: 40px;
        height: 22px;
        background: var(--background-overlay);
        border-radius: 11px;
        cursor: pointer;
        position: relative;
        border: 1px solid rgba(255, 255, 255, 0.08);
      }
      .toggle::after,
      .switch::after {
        content: '';
        position: absolute;
        top: 2px;
        left: 2px;
        width: 16px;
        height: 16px;
        background: var(--text-secondary);
        border-radius: 50%;
        transition: 0.15s;
      }
      .toggle.active,
      .switch[aria-checked='true'] {
        background: #6366f1;
        border-color: #6366f1;
      }
      .toggle.active::after,
      .switch[aria-checked='true']::after {
        left: 20px;
        background: #fff;
      }
      /* A bigger tap area than the switch itself, for fingers. */
      .toggle::before,
      .switch::before {
        content: '';
        position: absolute;
        inset: -12px -8px;
      }
      .toast {
        animation: toast 0.2s ease;
      }
      @keyframes toast {
        from {
          opacity: 0;
          transform: translateY(6px);
        }
        to {
          opacity: 1;
          transform: translateY(0);
        }
      }
    </style>
  </head>

  <body class="bg-background font-linux text-text-header min-h-screen p-4 sm:p-6 md:p-8">
    <div class="mx-auto max-w-5xl">
      <div class="flex gap-8">
        <nav aria-label="Settings categories" class="hidden w-48 shrink-0 lg:block">
          <div class="sticky top-6 space-y-1">
            <header class="mb-8">
              <h1 class="mb-1 text-2xl font-bold">Settings</h1>
              <p class="text-text-secondary text-sm">Customize Persec</p>
            </header>
            <a
              href="#privacy"
              class="nav-item hover:text-text-header flex items-center gap-2.5 rounded-lg focus-visible:outline-2 focus-visible:outline-[#8b87ff] bg-[#6366f1]/10 px-3 py-2 text-sm text-[#6366f1] hover:bg-white/5"
              data-nav="privacy"
            >
              <i data-lucide="shield" class="h-4 w-4"></i>Privacy
            </a>
            <a
              href="#browsing"
              class="nav-item text-text-secondary hover:text-text-header flex items-center gap-2.5 rounded-lg focus-visible:outline-2 focus-visible:outline-[#8b87ff] px-3 py-2 text-sm hover:bg-white/5"
              data-nav="browsing"
            >
              <i data-lucide="globe" class="h-4 w-4"></i>Browsing
            </a>
            <a
              href="#advanced"
              class="nav-item text-text-secondary hover:text-text-header flex items-center gap-2.5 rounded-lg focus-visible:outline-2 focus-visible:outline-[#8b87ff] px-3 py-2 text-sm hover:bg-white/5"
              data-nav="advanced"
            >
              <i data-lucide="wrench" class="h-4 w-4"></i>Advanced
            </a>
            <a
              href="#about"
              class="nav-item text-text-secondary hover:text-text-header flex items-center gap-2.5 rounded-lg focus-visible:outline-2 focus-visible:outline-[#8b87ff] px-3 py-2 text-sm hover:bg-white/5"
              data-nav="about"
            >
              <i data-lucide="info" class="h-4 w-4"></i>About
            </a>
          </div>
        </nav>

        <main class="min-w-0 flex-1 space-y-10">
          <!-- Search for every screen; the category bar is for screens without the side list. -->
          <div class="bg-background sticky top-0 z-20 -mx-4 space-y-3 px-4 pt-1 pb-3 sm:-mx-6 sm:px-6 lg:mx-0 lg:px-0">
            <h1 class="text-2xl font-bold lg:hidden">Settings</h1>
            <div class="relative" role="search">
              <i
                data-lucide="search"
                class="text-text-secondary pointer-events-none absolute top-1/2 left-3 h-4 w-4 -translate-y-1/2"
              ></i>
              <label for="settings-search" class="sr-only">
                Search settings
              </label>
              <input
                id="settings-search"
                type="search"
                data-filter-input
                autocomplete="off"
                placeholder="Search settings"
                class="bg-background-overlay/80 w-full rounded-lg border border-white/10 py-2.5 pr-11 pl-9 text-sm focus:border-[#8b87ff] focus:outline-none [&::-webkit-search-cancel-button]:hidden"
              />
              <button
                type="button"
                data-filter-clear
                hidden
                aria-label="Clear search"
                class="text-text-secondary hover:text-text-header absolute top-1/2 right-1 flex h-9 w-9 -translate-y-1/2 items-center justify-center rounded-md focus-visible:outline-2 focus-visible:outline-[#8b87ff]"
              >
                <i data-lucide="x" class="h-4 w-4"></i>
              </button>
            </div>
            <nav aria-label="Settings categories" class="flex gap-1 overflow-x-auto [scrollbar-width:none] lg:hidden">
              <a
                href="#privacy"
                data-nav="privacy"
                class="nav-item text-text-secondary flex min-h-11 shrink-0 items-center gap-2 rounded-full px-4 text-sm hover:bg-white/5 focus-visible:outline-2 focus-visible:outline-[#8b87ff]"
              >
                <i data-lucide="shield" class="h-4 w-4"></i>Privacy
              </a>
              <a
                href="#browsing"
                data-nav="browsing"
                class="nav-item text-text-secondary flex min-h-11 shrink-0 items-center gap-2 rounded-full px-4 text-sm hover:bg-white/5 focus-visible:outline-2 focus-visible:outline-[#8b87ff]"
              >
                <i data-lucide="globe" class="h-4 w-4"></i>Browsing
              </a>
              <a
                href="#advanced"
                data-nav="advanced"
                class="nav-item text-text-secondary flex min-h-11 shrink-0 items-center gap-2 rounded-full px-4 text-sm hover:bg-white/5 focus-visible:outline-2 focus-visible:outline-[#8b87ff]"
              >
                <i data-lucide="wrench" class="h-4 w-4"></i>Advanced
              </a>
              <a
                href="#about"
                data-nav="about"
                class="nav-item text-text-secondary flex min-h-11 shrink-0 items-center gap-2 rounded-full px-4 text-sm hover:bg-white/5 focus-visible:outline-2 focus-visible:outline-[#8b87ff]"
              >
                <i data-lucide="info" class="h-4 w-4"></i>About
              </a>
            </nav>
          </div>
          <p data-filter-empty role="status" class="text-text-secondary text-sm"></p>
          <section id="privacy" data-section="privacy">
            <h2 class="mb-4 flex items-center text-lg font-semibold">
              <i data-lucide="shield" class="mr-2 h-5 w-5 text-[#6366f1]"></i>
              Privacy & Cloaking
            </h2>

            <div class="space-y-3">
              <div class="bg-background-overlay/60 rounded-xl border border-white/6 p-5">
                <h3 class="mb-2 font-medium">Clear site data</h3>
                <p class="text-text-secondary mb-3 text-sm">
                  Sites you open in Persec can read each other's cookies. Clear them after logging in anywhere, and
                  before visiting sites you don't trust. You'll be logged out of every site, and your saved-logins
                  backup on this server is deleted too. Your Persec settings and bookmarks are kept.
                </p>
                <button
                  data-clear-site-data
                  class="flex items-center gap-2 rounded-lg border border-[#6366f1]/30 bg-[#6366f1]/15 px-4 py-2 text-sm hover:bg-[#6366f1]/25"
                >
                  <i data-lucide="trash-2" class="h-4 w-4"></i>Clear cookies and site data
                </button>
              </div>

              <div data-logins hidden class="bg-background-overlay/60 rounded-xl border border-white/6 p-5">
                <div class="flex items-start justify-between gap-4">
                  <div>
                    <h3 id="logins-title" class="font-medium">
                      Saved logins
                    </h3>
                    <p class="text-text-secondary text-sm">
                      Keep an encrypted backup of your site logins with your invite code, so you're still signed in when
                      you come back on any device. Anyone with your invite code can unlock it, including whoever runs
                      this server. Turning this off deletes the backup.
                    </p>
                    <p data-logins-status class="text-text-secondary mt-2 text-xs"></p>
                  </div>
                  <button
                    type="button"
                    role="switch"
                    aria-checked="false"
                    aria-labelledby="logins-title"
                    data-logins-toggle
                    class="switch mt-1 shrink-0"
                  ></button>
                </div>
                <form data-logins-code hidden class="mt-3 flex flex-col gap-2 sm:flex-row">
                  <label for="logins-code" class="sr-only">
                    Invite code
                  </label>
                  <input
                    id="logins-code"
                    type="password"
                    autocomplete="current-password"
                    placeholder="Enter your invite code to turn this on"
                    class="bg-background/80 min-w-0 flex-1 rounded-lg border border-white/6 px-4 py-2.5 text-base focus:border-[#6366f1]/40 focus:outline-none sm:text-sm"
                  />
                  <button
                    type="submit"
                    class="rounded-lg border border-[#6366f1]/30 bg-[#6366f1]/15 px-4 py-2.5 text-sm hover:bg-[#6366f1]/25"
                  >
                    Turn on
                  </button>
                </form>
                <button
                  type="button"
                  data-logins-restore
                  hidden
                  class="mt-3 flex items-center gap-2 rounded-lg border border-[#6366f1]/30 bg-[#6366f1]/15 px-4 py-2 text-sm hover:bg-[#6366f1]/25"
                >
                  <i data-lucide="refresh-cw" class="h-4 w-4"></i>Restore saved logins here
                </button>
              </div>

              <div class="bg-background-overlay/60 rounded-xl border border-white/6 p-5">
                <h3 class="mb-2 font-medium">About:Blank Cloak</h3>
                <p class="text-text-secondary mb-3 text-sm">
                  Opens Persec inside a blank tab whose address shows as <code>about:blank</code>, so this site doesn't
                  appear in your browser history or address bar. This tab then goes to the redirect address below.
                </p>
                <input
                  type="text"
                  data-input="aboutBlankUrl"
                  class="bg-background/80 mb-3 w-full rounded-lg border border-white/6 px-3 py-2.5 text-sm focus:border-[#6366f1]/40 focus:outline-none"
                  placeholder="Redirect URL (e.g. https://classroom.google.com)"
                />
                <button
                  data-about-blank
                  class="flex items-center gap-2 rounded-lg border border-[#6366f1]/30 bg-[#6366f1]/15 px-4 py-2 text-sm hover:bg-[#6366f1]/25"
                >
                  <i data-lucide="external-link" class="h-4 w-4"></i>Open in About:Blank
                </button>
              </div>

              <div class="bg-background-overlay/60 rounded-xl border border-white/6 p-5" data-cloak-container>
                <div class="mb-4 flex items-center justify-between">
                  <div>
                    <h3 class="font-medium">Tab Cloak</h3>
                    <p class="text-text-secondary text-sm">
                      Makes this tab's title and icon look like another site, such as Google Drive, so it doesn't stand
                      out among your tabs.
                    </p>
                  </div>
                  <button
                    type="button"
                    role="switch"
                    aria-checked="false"
                    aria-label="Tab Cloak"
                    class="toggle shrink-0 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-[#8b87ff]"
                    data-toggle="cloak"
                  ></button>
                </div>

                <div data-cloak-inputs class="space-y-3 border-t border-white/6 pt-4">
                  <div class="flex gap-2">
                    <button
                      data-cloak-preset="google"
                      data-preset-title="Google"
                      data-preset-favicon="/a/images/co/go.ico"
                      class="cloak-preset bg-background/60 hover:bg-background/80 flex flex-1 items-center justify-center gap-2 rounded-lg border border-white/6 px-3 py-2 text-sm"
                    >
                      <img src="/a/images/co/go.ico" class="h-4 w-4" alt="" />
                      Google
                    </button>
                    <button
                      data-cloak-preset="drive"
                      data-preset-title="Google Drive"
                      data-preset-favicon="/a/images/co/drei.png"
                      class="cloak-preset bg-background/60 hover:bg-background/80 flex flex-1 items-center justify-center gap-2 rounded-lg border border-white/6 px-3 py-2 text-sm"
                    >
                      <img src="/a/images/co/drei.png" class="h-4 w-4" alt="" />
                      Drive
                    </button>
                    <button
                      data-cloak-preset="classroom"
                      data-preset-title="Home"
                      data-preset-favicon="/a/images/co/class.png"
                      class="cloak-preset bg-background/60 hover:bg-background/80 flex flex-1 items-center justify-center gap-2 rounded-lg border border-white/6 px-3 py-2 text-sm"
                    >
                      <img src="/a/images/co/class.png" class="h-4 w-4" alt="" />
                      Classroom
                    </button>
                  </div>
                  <input
                    type="text"
                    data-input="cloakTitle"
                    placeholder="Tab title"
                    disabled
                    class="cloak-input bg-background/80 w-full rounded-lg border border-white/6 px-4 py-2.5 text-sm focus:border-[#6366f1]/40 focus:outline-none disabled:opacity-50"
                  />
                  <input
                    type="text"
                    data-input="cloakFavicon"
                    placeholder="Favicon URL"
                    disabled
                    class="cloak-input bg-background/80 w-full rounded-lg border border-white/6 px-4 py-2.5 text-sm focus:border-[#6366f1]/40 focus:outline-none disabled:opacity-50"
                  />
                </div>
              </div>

              <div class="bg-background-overlay/60 flex items-center justify-between rounded-xl border border-white/6 p-5">
                <div>
                  <h3 class="font-medium">Tab Switch Cloak</h3>
                  <p class="text-text-secondary text-sm">
                    Disguises the tab (using the Tab Cloak title and icon) only while you're on another tab, and shows
                    Persec again when you come back.
                  </p>
                </div>
                <button
                  type="button"
                  role="switch"
                  aria-checked="false"
                  aria-label="Tab Switch Cloak"
                  class="toggle shrink-0 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-[#8b87ff]"
                  data-toggle="tabSwitchCloak"
                ></button>
              </div>

              <div class="bg-background-overlay/60 flex items-center justify-between rounded-xl border border-white/6 p-5">
                <div>
                  <h3 class="font-medium">Anti-close</h3>
                  <p class="text-text-secondary text-sm">
                    Asks you to confirm before Persec's tab closes. Helps when a web filter or extension closes tabs
                    automatically.
                  </p>
                </div>
                <button
                  type="button"
                  role="switch"
                  aria-checked="false"
                  aria-label="Anti-close"
                  class="toggle shrink-0 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-[#8b87ff]"
                  data-toggle="beforeUnload"
                ></button>
              </div>

              <div class="bg-background-overlay/60 rounded-xl border border-white/6 p-5">
                <h3 class="mb-2 font-medium">Panic Key</h3>
                <p class="text-text-secondary mb-3 text-sm">
                  Press this key to send the tab straight to the address on the left, for example if someone walks by.
                  Click the box on the right, then press the key you want to use.
                </p>
                <div class="grid grid-cols-1 gap-3 sm:grid-cols-2">
                  <input
                    type="text"
                    data-input="panicLoc"
                    placeholder="URL to redirect to"
                    class="bg-background/80 w-full rounded-lg border border-white/6 px-4 py-2.5 text-sm focus:border-[#6366f1]/40 focus:outline-none"
                  />
                  <input
                    type="text"
                    data-input="panicKey"
                    placeholder="Click to set keybind"
                    readonly
                    class="bg-background/80 w-full cursor-pointer rounded-lg border border-white/6 px-4 py-2.5 text-sm focus:border-[#6366f1]/40 focus:outline-none"
                  />
                </div>
              </div>
            </div>
          </section>

          <section id="browsing" data-section="browsing">
            <h2 class="mb-4 flex items-center gap-2 text-lg font-semibold">
              <i data-lucide="globe" class="h-5 w-5 text-pink-400"></i>
              Browsing
            </h2>

            <div class="space-y-3">
              <div class="bg-background-overlay/60 rounded-xl border border-white/6 p-5">
                <h3 class="mb-1 font-medium">Proxy Backend</h3>
                <p class="text-text-secondary mb-3 text-sm">
                  The engine that loads websites for you inside Persec. If a site won't load or looks broken, switch to
                  the other one and try again.
                </p>
                <div class="grid grid-cols-2 gap-3">
                  <button
                    data-proxy="scramjet"
                    class="proxy-button bg-background/60 relative rounded-lg border border-white/6 p-4 text-left hover:border-[#6366f1]/30 hover:bg-[#6366f1]/10"
                  >
                    <div class="text-sm font-medium">Scramjet</div>
                    <div class="text-text-secondary text-xs">Newer and faster; a few sites may break</div>
                    <div class="proxy-check absolute top-2 right-2 hidden">
                      <i data-lucide="check" class="h-4 w-4 text-[#6366f1]"></i>
                    </div>
                  </button>
                  <button
                    data-proxy="ultraviolet"
                    class="proxy-button bg-background/60 relative rounded-lg border border-white/6 p-4 text-left hover:border-pink-400/30 hover:bg-pink-400/10"
                  >
                    <div class="text-sm font-medium">Ultraviolet</div>
                    <div class="text-text-secondary text-xs">Older and slower, but works with more sites</div>
                    <div class="proxy-check absolute top-2 right-2 hidden">
                      <i data-lucide="check" class="h-4 w-4 text-pink-400"></i>
                    </div>
                  </button>
                </div>
              </div>

              <div class="bg-background-overlay/60 rounded-xl border border-white/6 p-5">
                <h3 class="mb-1 font-medium">Search Engine</h3>
                <p class="text-text-secondary mb-3 text-sm">
                  Used when you type something in the address bar that isn't a web address.
                </p>
                <div class="mb-4 grid grid-cols-2 gap-2 sm:grid-cols-4">
                  <button
                    data-engine="https://duckduckgo.com/?q="
                    class="engine-button bg-background/60 relative flex items-center justify-center gap-2 rounded-lg border border-white/6 py-2.5 text-xs hover:bg-[#6366f1]/10"
                  >
                    <img src="/a/images/engines/ddg.ico" alt="DuckDuckGo" class="h-4 w-4" />
                    DuckDuckGo
                    <div class="engine-check absolute -top-1 -right-1 hidden">
                      <i data-lucide="check-circle" class="h-3.5 w-3.5 text-[#6366f1]"></i>
                    </div>
                  </button>
                  <button
                    data-engine="https://www.google.com/search?q="
                    class="engine-button bg-background/60 relative flex items-center justify-center gap-2 rounded-lg border border-white/6 py-2.5 text-xs hover:bg-[#6366f1]/10"
                  >
                    <img src="/a/images/co/go.ico" alt="Google" class="h-4 w-4" />
                    Google
                    <div class="engine-check absolute -top-1 -right-1 hidden">
                      <i data-lucide="check-circle" class="h-3.5 w-3.5 text-[#6366f1]"></i>
                    </div>
                  </button>
                  <button
                    data-engine="https://www.bing.com/search?q="
                    class="engine-button bg-background/60 relative flex items-center justify-center gap-2 rounded-lg border border-white/6 py-2.5 text-xs hover:bg-[#6366f1]/10"
                  >
                    <img src="/a/images/engines/bi.ico" alt="Bing" class="h-4 w-4" />
                    Bing
                    <div class="engine-check absolute -top-1 -right-1 hidden">
                      <i data-lucide="check-circle" class="h-3.5 w-3.5 text-[#6366f1]"></i>
                    </div>
                  </button>
                  <button
                    data-engine="https://search.brave.com/search?q="
                    class="engine-button bg-background/60 relative flex items-center justify-center gap-2 rounded-lg border border-white/6 py-2.5 text-xs hover:bg-[#6366f1]/10"
                  >
                    <img src="/a/images/engines/br.jpeg" alt="Brave" class="h-4 w-4" />
                    Brave
                    <div class="engine-check absolute -top-1 -right-1 hidden">
                      <i data-lucide="check-circle" class="h-3.5 w-3.5 text-[#6366f1]"></i>
                    </div>
                  </button>
                </div>
                <input
                  type="text"
                  data-input="engine"
                  aria-label="Custom search address"
                  placeholder="Or your own: a search address ending in ?q= or &q="
                  class="bg-background/80 w-full rounded-lg border border-white/6 px-4 py-2.5 text-sm focus:border-[#6366f1]/40 focus:outline-none"
                />
              </div>
              <div class="bg-background-overlay/60 flex items-center justify-between rounded-xl border border-white/6 p-5">
                <div>
                  <h3 class="font-medium">Ad Blocker (experimental)</h3>
                  <p class="text-text-secondary text-sm">
                    Stops common ads and trackers from loading on sites you open. Turn it off if a site doesn't work
                    properly.
                  </p>
                </div>
                <button
                  type="button"
                  role="switch"
                  aria-checked="false"
                  aria-label="Ad Blocker"
                  class="toggle shrink-0 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-[#8b87ff]"
                  data-toggle="adBlock"
                ></button>
              </div>
            </div>
          </section>

          <section id="advanced" data-section="advanced">
            <h2 class="mb-4 flex items-center gap-2 text-lg font-semibold">
              <i data-lucide="wrench" class="h-5 w-5 text-amber-400"></i>
              Advanced
            </h2>

            <div class="space-y-3">
              <div class="bg-background-overlay/60 rounded-xl border border-white/6 p-5">
                <h3 class="mb-2 font-medium">Wisp Server</h3>
                <p class="text-text-secondary mb-3 text-sm">
                  Wisp is the connection Persec uses to reach websites: a tunnel (a WebSocket) from your browser to this
                  Persec server. Leave it as it is unless whoever runs Persec gives you a different address.
                </p>
                <input
                  type="text"
                  data-input="wispUrl"
                  placeholder="ws://localhost:3000/wisp/"
                  class="bg-background/80 w-full rounded-lg border border-white/6 px-4 py-2.5 text-sm focus:border-[#6366f1]/40 focus:outline-none"
                />
              </div>

              <div class="bg-background-overlay/60 rounded-xl border border-white/6 p-5">
                <h3 class="mb-2 font-medium">Check connection</h3>
                <p class="text-text-secondary mb-3 text-sm">
                  Checks what the proxy needs in this browser and the connection to this server, so you can tell whether
                  a problem is this browser, this network, or the site you're opening.
                </p>
                <button
                  data-check-connection
                  class="flex items-center gap-2 rounded-lg border border-[#6366f1]/30 bg-[#6366f1]/15 px-4 py-2 text-sm hover:bg-[#6366f1]/25"
                >
                  <i data-lucide="activity" class="h-4 w-4"></i>Run checks
                </button>
                <div data-check-result role="status" class="text-text-secondary mt-3 text-sm"></div>
              </div>

              <div class="bg-background-overlay/60 rounded-xl border border-white/6 p-5">
                <h3 class="mb-2 font-medium">Move to another address</h3>
                <p class="text-text-secondary mb-3 text-sm">
                  Each Persec address (including a backup server) keeps its own settings and bookmarks. Export them here
                  and import the file at the other address. Saved logins move separately: sign in there with your invite
                  code and restore them. The file is not encrypted, so keep it private.
                </p>
                <div class="flex flex-wrap gap-2">
                  <button
                    data-export-settings
                    class="flex items-center gap-2 rounded-lg border border-[#6366f1]/30 bg-[#6366f1]/15 px-4 py-2 text-sm hover:bg-[#6366f1]/25"
                  >
                    <i data-lucide="download" class="h-4 w-4"></i>Export settings
                  </button>
                  <label class="cursor-pointer flex items-center gap-2 rounded-lg border border-[#6366f1]/30 bg-[#6366f1]/15 px-4 py-2 text-sm hover:bg-[#6366f1]/25">
                    <i data-lucide="upload" class="h-4 w-4"></i>Import settings
                    <input data-import-settings type="file" accept="application/json,.json" class="sr-only" />
                  </label>
                </div>
              </div>

              <div class="bg-background-overlay/60 rounded-xl border border-red-500/20 p-5">
                <h3 class="mb-2 flex items-center gap-2 font-medium text-amber-400">
                  <i data-lucide="alert-triangle" class="h-4 w-4"></i>
                  Clear All Data
                </h3>
                <p class="text-text-secondary mb-3 text-sm">
                  Resets every Persec setting and deletes your bookmarks and start page shortcuts in this browser. Site
                  cookies and saved logins aren't touched (use Clear site data for those). This can't be undone.
                </p>
                <button
                  data-reset="reset"
                  class="rounded-lg border border-red-500/30 bg-red-500/10 px-4 py-2 text-sm text-red-400 hover:bg-red-500/20"
                >
                  Clear All Data
                </button>
              </div>
            </div>
          </section>

          <section id="about" data-section="about">
            <h2 class="mb-4 flex items-center gap-2 text-lg font-semibold">
              <i data-lucide="info" class="h-5 w-5 text-[#6366f1]"></i>
              About
            </h2>

            <div class="bg-background-overlay/60 rounded-xl border border-white/6 p-5">
              <div class="mb-4 flex items-center gap-4">
                <div class="flex h-12 w-12 items-center justify-center rounded-xl bg-[#6366f1]/20">
                  <img src="/a/persec.svg" alt="" class="h-6 w-6" />
                </div>
                <div>
                  <h3 class="text-lg font-semibold">Persec</h3>
                  <p class="text-text-secondary text-sm">v{VERSION}</p>
                </div>
              </div>

              <div class="mb-4 space-y-2 text-sm">
                <div class="flex justify-between">
                  <span class="text-text-secondary">Based on</span>
                  <span>Lunar v2 by Bearcattt</span>
                </div>
                <div class="flex justify-between">
                  <span class="text-text-secondary">License</span>
                  <span>AGPL-3.0</span>
                </div>
                <div class="flex justify-between">
                  <span class="text-text-secondary">Built with</span>
                  <span>Astro, TypeScript, Tailwind</span>
                </div>
              </div>

              <div class="flex gap-2">
                <a
                  href="https://github.com/Trackertheweasel/xenapsis"
                  target="_blank"
                  class="bg-background/60 flex items-center gap-2 rounded-lg border border-white/6 px-3 py-2 text-sm transition-colors duration-150 hover:border-[#6366f1]/30 hover:bg-[#6366f1]/10 hover:text-[#6366f1]"
                >
                  <i data-lucide="code" class="h-4 w-4 transition-colors duration-150 group-hover:text-[#6366f1]"></i>
                  Source code
                </a>
                <a
                  href="/privacy"
                  class="bg-background/60 flex items-center gap-2 rounded-lg border border-white/6 px-3 py-2 text-sm transition-colors duration-150 hover:border-[#10b981]/30 hover:bg-[#10b981]/10 hover:text-[#10b981]"
                >
                  <i data-lucide="shield" class="h-4 w-4"></i>Privacy &amp; safety
                </a>
              </div>
            </div>
          </section>
        </main>
      </div>

      <!-- Always in the page (hidden with a class) so screen readers announce each new message. -->
      <div
        data-notification
        role="status"
        class="toast pointer-events-none fixed right-4 bottom-4 z-30 opacity-0 sm:right-6 sm:bottom-6"
      >
        <div
          data-notification-box
          class="bg-background-overlay flex max-w-sm items-center gap-2 rounded-lg border border-[#10b981]/40 px-4 py-3 text-sm"
        >
          <span data-notification-text></span>
        </div>
      </div>

      <!-- In-page confirmation for actions that delete things (SettingsManager.confirm). -->
      <dialog
        data-confirm
        aria-labelledby="confirm-title"
        class="bg-background-overlay text-text-header m-auto w-[min(28rem,calc(100vw-2rem))] rounded-xl border border-white/10 p-5 backdrop:bg-black/60"
      >
        <form method="dialog">
          <h2 id="confirm-title" class="mb-2 font-semibold"></h2>
          <div data-confirm-text class="text-text-secondary space-y-2 text-sm"></div>
          <div class="mt-5 flex flex-wrap justify-end gap-2">
            <button
              value="cancel"
              class="min-h-11 rounded-lg border border-white/10 bg-white/5 px-4 text-sm hover:bg-white/10"
            >
              Cancel
            </button>
            <button
              value="ok"
              data-confirm-ok
              class="min-h-11 rounded-lg border border-red-500/30 bg-red-500/15 px-4 text-sm text-red-300 hover:bg-red-500/25"
            ></button>
          </div>
        </form>
      </dialog>
    </div>

    <ImportLucide />
    <script>
      import('../utils/st').then(({ SettingsManager }) => SettingsManager.init());
      import('../utils/config').then(({ default: ConfigAPI }) => {
        document.querySelector('[data-about-blank]')?.addEventListener('click', async () => {
          if (top?.location.href === 'about:blank') return;
          const win = top?.window.open();
          if (top && top.window) {
            top.window.location.href = (await ConfigAPI.get('panicLoc')) || 'https://google.com';
          }
          if (!win) return;

          const viewport = win.document.createElement('meta');
          viewport.name = 'viewport';
          viewport.content = 'width=device-width, initial-scale=1';
          win.document.head.appendChild(viewport);
          const iframe = win.document.createElement('iframe');
          iframe.style.cssText = 'width:100%;height:100vh;height:100dvh;border:0;margin:0;padding:0;display:block';
          iframe.src = location.origin + '/';

          win.document.body.style.margin = '0';
          win.document.title = 'about:blank';
          win.document.body.appendChild(iframe);
        });
      });
    </script>
  </body>
</html>
