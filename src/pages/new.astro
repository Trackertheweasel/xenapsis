---
import '@/main.css';
import Shortcuts from '../layouts/shortcuts.astro';
import Sponsor from '../components/Sponsor.astro';
import quotes from '../../public/a/json/quotes.json';

const randomIndex = Math.floor(Math.random() * quotes.length);
const randomQuote = quotes[randomIndex]?.quote || '';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <title>New Tab</title>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
  </head>

  <body class="font-linux bg-background relative flex min-h-dvh w-full flex-col items-center justify-center overflow-x-hidden px-4 py-8 text-white sm:px-0 sm:py-24">
    <div
      class="absolute inset-0 opacity-[0.02]"
      style="background-image: url('data:image/svg+xml,%3Csvg width=\'60\' height=\'60\' viewBox=\'0 0 60 60\' xmlns=\'http://www.w3.org/2000/svg\'%3E%3Cg fill=\'none\' fill-rule=\'evenodd\'%3E%3Cg fill=\'%23ffffff\' fill-opacity=\'1\'%3E%3Cpath d=\'M36 34v-4h-2v4h-4v2h4v4h2v-4h4v-2h-4zm0-30V0h-2v4h-4v2h4v4h2V6h4V4h-4zM6 34v-4H4v4H0v2h4v4h2v-4h4v-2H6zM6 4V0H4v4H0v2h4v4h2V6h4V4H6z\'/%3E%3C/g%3E%3C/g%3E%3C/svg%3E');"
    ></div>

    <div class="relative z-10 flex flex-col items-center space-y-5 sm:space-y-8">
      <p id="greeting" class="hidden text-lg font-semibold text-white/80 sm:text-2xl"></p>
      <div id="clock" class="flex items-baseline space-x-1 select-none">
        <span
          id="hours"
          class="text-[clamp(3rem,10vw,7rem)] leading-none font-black tracking-tighter text-white"
          style="text-shadow: 0 0 40px rgba(255,255,255,0.1);"
        >
          12
        </span>
        <span class="text-[clamp(3rem,10vw,7rem)] leading-none font-black tracking-tighter opacity-40">:</span>
        <span
          id="minutes"
          class="text-[clamp(3rem,10vw,7rem)] leading-none font-black tracking-tighter text-white"
          style="text-shadow: 0 0 40px rgba(255,255,255,0.1);"
        >
          59
        </span>
        <span class="text-[clamp(3rem,10vw,7rem)] leading-none font-black tracking-tighter opacity-40">:</span>
        <span
          id="seconds"
          class="text-[clamp(3rem,10vw,7rem)] leading-none font-black tracking-tighter text-white opacity-50"
          style="text-shadow: 0 0 40px rgba(255,255,255,0.1);"
        >
          48
        </span>
        <span id="ampm" class="mt-2 ml-2 self-start text-[clamp(0.8rem,2.5vw,1.2rem)] font-bold text-white opacity-40">
          AM
        </span>
      </div>

      <div class="max-w-xl px-2 text-center sm:px-6">
        <span class="text-base font-medium tracking-wide text-white/70 sm:text-lg">{randomQuote}</span>
      </div>
    </div>

    <Shortcuts />
    <Sponsor />

    <!-- Pinned to the corners on larger screens; on phones they sit below the shortcuts instead of over them. -->
    <footer class="relative z-10 mt-8 flex flex-wrap items-center justify-center gap-3 sm:contents">
      <div class="border-border-default/20 bg-background-overlay/40 z-50 flex items-center gap-2 rounded-full border px-4 py-2 shadow-xl backdrop-blur-md sm:fixed sm:right-5 sm:bottom-5">
        <span class="text-[12px] font-medium text-white/50 transition hover:text-white/80">v{VERSION}</span>
        <span class="h-3 w-px bg-white/20"></span>
        <a href="/privacy" class="text-[12px] font-medium text-white/50 transition hover:text-white/80">
          Privacy &amp; safety
        </a>
      </div>
      <div class="border-border-default/20 bg-background-overlay/50 z-50 flex items-center gap-3 rounded-full border px-4 py-2 shadow-xl backdrop-blur-md sm:fixed sm:bottom-5 sm:left-5">
        <span id="sl" class="text-xs font-medium text-white/60 tabular-nums">
          ...
        </span>
        <div class="h-4 w-px bg-white/20"></div>
        <button
          id="refresh"
          aria-label="Check server speed again"
          class="text-white/40 transition-all duration-200 hover:rotate-180 hover:text-white/80 focus:outline-none"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            class="h-4 w-4"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
            stroke-width="2.5"
          >
            <path stroke-linecap="round" stroke-linejoin="round" d="M21 12a9 9 0 11-3-6.708M21 3v6h-6"></path>
          </svg>
        </button>
      </div>
    </footer>

    <script src="@scripts/new"></script>
  </body>
</html>
