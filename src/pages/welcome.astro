---
// Static page: built once at deploy time instead of rendered on every request.
export const prerender = true;
import '@/main.css';
import Tabs from '../layouts/tab.astro';
import SideBar from '../layouts/side.astro';
import ProxyRuntime from '../components/ProxyRuntime.astro';
---

<head></head>
<body class="h-screen text-white">
  <Tabs />
  <ProxyRuntime />
  <script>
    import { initNavigation } from '../utils/navigation';
    initNavigation();
  </script>

  <SideBar />
</body>
