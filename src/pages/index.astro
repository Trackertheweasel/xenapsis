---
// Static page: built once at deploy time instead of rendered on every request.
export const prerender = true;
import '@/main.css';
import ImportLucide from '../layouts/lucide.astro';
import CookieBanner from '../components/CookieBanner.astro';
---

<!doctype html>
<html lang="en" style="background:#11121c;">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <title>Persec</title>
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <meta name="theme-color" content="#11121c" />
    <style>
      html,
      body {
        background: #11121c;
      }
      /* viewport-fit=cover lets Persec use the whole screen, so keep it clear of notches and home bars. */
      body {
        padding: env(safe-area-inset-top) env(safe-area-inset-right) env(safe-area-inset-bottom)
          env(safe-area-inset-left);
        box-sizing: border-box;
      }
    </style>
    <script src="@scripts/config"></script>
    <script src="@scripts/index"></script>
  </head>
  <body class="flex h-dvh w-screen overflow-hidden text-gray-900" style="background:#11121c;">
    <div class="flex flex-1 flex-col">
      <div class="relative flex-1">
        <iframe id="frame" src="/welcome" title="Persec" class="absolute inset-0 h-full w-full border-none"></iframe>
      </div>
    </div>
    <CookieBanner />
    <ImportLucide />
  </body>
</html>
