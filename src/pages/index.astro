---
import '@/main.css';
import ImportLucide from '../layouts/lucide.astro';
---

<!doctype html>
<html lang="en" style="background:#11121c;">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="generator" content={Astro.generator} />
    <title>Persec</title>
    <meta name="description" content="Persec is a browser-like web proxy for reaching an open internet." />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <style>
      html, body { background: #11121c; }
    </style>
    <script src="@scripts/config"></script>
    <script src="@scripts/index"></script>
  </head>
  <body class="flex h-screen w-screen overflow-hidden text-gray-900" style="background:#11121c;">
    <div class="flex flex-1 flex-col h-dvh">
      <div class="relative flex-1">
        <iframe
          id="frame"
          src="/welcome"
          class="absolute inset-0 h-full w-full border-none"
        ></iframe>
      </div>
    </div>
    <ImportLucide />
  </body>
</html>
